{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "baseUrl": "./",
    "rootDir": "./src",
    "paths": {
      "@/*": ["src/*"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true
    // ⚠️ Pas d'`incremental` : `nest build` vide `dist/` à chaque passe, mais le
    // fichier .tsbuildinfo, lui, survit — tsc croit alors que tout est à jour et
    // ne réémet que les fichiers modifiés. On se retrouve avec un dist/ amputé
    // et un « Cannot find module dist/main.js » très déroutant.
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
