# ─── Base de données ───────────────────────────────────────────────────────
# Port 54320 : le 5432 du poste est déjà occupé (cf. docker-compose.yml).
DATABASE_URL="postgresql://fihadj:fihadj@localhost:54320/fihadj?schema=public"

# ─── API ───────────────────────────────────────────────────────────────────
PORT=3051
NODE_ENV=development
# Origines autorisées à appeler l'API (séparées par des virgules).
CORS_ORIGINS="http://localhost:3050"

# ─── JWT ───────────────────────────────────────────────────────────────────
# ⚠️ En production : deux secrets DIFFÉRENTS, générés par `openssl rand -base64 48`.
JWT_ACCESS_SECRET="dev-access-secret-a-remplacer-en-production"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="dev-refresh-secret-a-remplacer-en-production"
JWT_REFRESH_TTL="7d"

# ─── Emails transactionnels ────────────────────────────────────────────────
# En dev : Mailpit (docker compose) — rien ne sort du poste.
# Interface web : http://localhost:8026
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="FI-HADJ <no-reply@fi-hadj.ci>"

# ─── Fichiers ──────────────────────────────────────────────────────────────
# Stockage local en dev ; brancher un bucket S3 en production via le port StorageService.
UPLOAD_DIR="./uploads"
PUBLIC_API_URL="http://localhost:3051"
PUBLIC_WEB_URL="http://localhost:3050"

# ─── Compte d'amorçage (utilisé par `pnpm prisma:seed`) ────────────────────
SEED_ADMIN_EMAIL="admin@fi-hadj.ci"
SEED_ADMIN_PASSWORD="fihadj2025"
