// Schéma FI-HADJ — Forum International du Hadj.
//
// Le modèle est MULTI-ÉDITION dès l'origine (cahier §9 phase 3) : le contenu qui
// change d'une année sur l'autre (thème, objectifs, programme, prix, inscriptions,
// budget…) pend à une `Edition`, tandis que ce qui est permanent (promoteurs,
// catégories de cible, projections d'impact, médiathèque) reste global.
// Rattacher le contenu après coup aurait imposé une migration de données pénible.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ⚠️ Miroir exact de `packages/shared-types/src/enums.ts`.
enum Role {
  SUPER_ADMIN
  COMMISSAIRE_GENERAL
  COMMISSAIRE_ADJOINT_1
  COMMISSAIRE_ADJOINT_2
  RESPONSABLE_LOGISTIQUE
  RESPONSABLE_COMMUNICATION
  RESPONSABLE_PARTENARIATS_SPONSORING
  RESPONSABLE_EXPOSITIONS
  RESPONSABLE_ATELIERS_PANELS
  RESPONSABLE_EVENEMENTIEL
  RESPONSABLE_FINANCIER
  RESPONSABLE_RH
  RESPONSABLE_IT
}

enum RegistrationType {
  PARTICIPANT
  EXPOSANT
  SPONSOR
}

enum RegistrationStatus {
  EN_ATTENTE
  VALIDE
  REJETE
}

enum PaymentStatus {
  NON_APPLICABLE
  EN_ATTENTE
  PAYE
  REMBOURSE
}

enum Civility {
  M
  MME
  DR
  PR
  SE
  CHEIKH
  IMAM
}

enum ProgramItemType {
  CEREMONIE
  PANEL
  ATELIER
  EXPOSITION
  GALA
  PAUSE
}

enum ObjectiveType {
  GENERAL
  SPECIFIQUE
}

enum SponsorLevel {
  PLATINE
  OR
  ARGENT
  BRONZE
  PARTENAIRE
}

enum BudgetEntryType {
  RECETTE
  DEPENSE
}

enum StandStatus {
  LIBRE
  RESERVE
  ATTRIBUE
  PAYE
}

enum MediaType {
  LOGO
  IMAGE
  DOCUMENT
  GALERIE
}

enum ArticleStatus {
  BROUILLON
  PUBLIE
}

// ───────────────────────────── Édition ─────────────────────────────

model Edition {
  id           String   @id @default(uuid())
  year         Int      @unique
  title        String
  theme        String
  heroSubtitle String?
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  venue        String
  city         String
  /// Une seule édition courante à la fois — garanti applicativement par
  /// `EditionsService.setCurrent()`, qui remet les autres à false dans une transaction.
  isCurrent    Boolean  @default(false)
  registrationOpen Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  objectives      Objective[]
  expectedResults ExpectedResult[]
  themeBlock      Theme?
  programItems    ProgramItem[]
  prizes          Prize[]
  sponsors        Sponsor[]
  exhibitors      Exhibitor[]
  registrations   Registration[]
  budgetEntries   BudgetEntry[]
  orgChart        OrgChartMember[]

  @@index([isCurrent])
}

// ───────────────────────────── Utilisateurs ─────────────────────────────

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         Role
  phone        String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens    RefreshToken[]
  budgetEntries    BudgetEntry[]
  reviewedRegistrations Registration[] @relation("RegistrationReviewer")
  auditLogs        AuditLog[]
  orgChartEntry    OrgChartMember[]
  articles         Article[]
}

/// Jetons de rafraîchissement stockés HACHÉS : une fuite de la table ne permet
/// pas de rejouer une session. Un jeton révoqué (`revokedAt`) reste en base le
/// temps de sa validité pour détecter une réutilisation.
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Contenu institutionnel ─────────────────────────────

model Promoter {
  id          String  @id @default(uuid())
  name        String
  acronym     String
  description String  @db.Text
  logoUrl     String?
  websiteUrl  String?
  order       Int     @default(0)

  @@index([order])
}

model Objective {
  id        String        @id @default(uuid())
  editionId String
  type      ObjectiveType
  text      String        @db.Text
  order     Int           @default(0)

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId, type, order])
}

model ExpectedResult {
  id        String @id @default(uuid())
  editionId String
  text      String @db.Text
  order     Int    @default(0)

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId, order])
}

model Theme {
  id          String  @id @default(uuid())
  editionId   String  @unique
  title       String  @db.Text
  description String? @db.Text

  edition   Edition    @relation(fields: [editionId], references: [id], onDelete: Cascade)
  subThemes SubTheme[]
}

model SubTheme {
  id          String  @id @default(uuid())
  themeId     String
  title       String  @db.Text
  description String? @db.Text
  /// Clé de couleur dans `packages/design-tokens` (`panelColors`) — pas un hex,
  /// pour que la DA reste modifiable depuis un seul fichier.
  colorKey    String?
  order       Int     @default(0)

  theme        Theme         @relation(fields: [themeId], references: [id], onDelete: Cascade)
  programItems ProgramItem[]

  @@index([themeId, order])
}

model ProgramItem {
  id          String          @id @default(uuid())
  editionId   String
  subThemeId  String?
  title       String
  description String?         @db.Text
  type        ProgramItemType
  day         DateTime        @db.Date
  startTime   String          @db.VarChar(5)
  endTime     String          @db.VarChar(5)
  location    String?
  speakers    String[]        @default([])
  order       Int             @default(0)

  edition  Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  subTheme SubTheme? @relation(fields: [subThemeId], references: [id], onDelete: SetNull)

  @@index([editionId, day, startTime])
}

model Prize {
  id          String  @id @default(uuid())
  editionId   String
  name        String
  sponsorName String?
  laureate    String?
  description String? @db.Text
  order       Int     @default(0)

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId, order])
}

model TargetCategory {
  id            String   @id @default(uuid())
  name          String
  description   String?  @db.Text
  subCategories String[] @default([])
  order         Int      @default(0)

  registrations Registration[]

  @@index([order])
}

model ImpactProjection {
  id           String @id @default(uuid())
  year         Int    @unique
  onSite       Int
  online       Int
  trained      Int
  directJobs   Int
  indirectJobs Int
}

model OrgChartMember {
  id         String   @id @default(uuid())
  editionId  String
  position   String
  holderName String?
  missions   String[] @default([])
  /// Rôle applicatif correspondant, quand le poste en a un (cahier §5.5).
  role       Role?
  photoUrl   String?
  userId     String?
  order      Int      @default(0)

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([editionId, order])
}

/// Blocs de texte libres du site (contexte, justification, mentions légales,
/// coordonnées…). Un CMS léger clé/valeur : ajouter une section ne demande pas
/// de migration.
model SiteContent {
  id        String   @id @default(uuid())
  key       String   @unique
  title     String
  body      String   @db.Text
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id        String    @id @default(uuid())
  url       String
  type      MediaType
  caption   String?
  section   String?
  fileName  String?
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime  @default(now())

  @@index([type, section])
}

model Article {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  excerpt     String?
  content     String        @db.Text
  coverUrl    String?
  status      ArticleStatus @default(BROUILLON)
  publishedAt DateTime?
  authorId    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
}

// ───────────────────────────── Inscriptions ─────────────────────────────

model Registration {
  id        String   @id @default(uuid())
  editionId String
  /// Référence communicable (« FIH-2025-P-0042 »), unique et séquentielle par
  /// édition ET par type. Attribuée sous verrou consultatif Postgres.
  reference String   @unique
  sequence  Int
  type      RegistrationType
  civility  Civility
  firstName String
  lastName  String
  email     String
  phone     String
  country   String
  organization String?
  position     String?
  targetCategoryId String?
  message      String? @db.Text

  // Champs propres aux exposants
  activitySector String?
  standSize      String?
  websiteUrl     String?

  // Champ propre aux sponsors
  sponsorLevel SponsorLevel?

  status        RegistrationStatus @default(EN_ATTENTE)
  paymentStatus PaymentStatus      @default(NON_APPLICABLE)
  reviewReason  String?
  reviewedById  String?
  reviewedAt    DateTime?
  badgeIssuedAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  edition        Edition         @relation(fields: [editionId], references: [id], onDelete: Cascade)
  targetCategory TargetCategory? @relation(fields: [targetCategoryId], references: [id], onDelete: SetNull)
  reviewedBy     User?           @relation("RegistrationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  exhibitor      Exhibitor?

  /// Un même email ne s'inscrit qu'une fois par édition et par type — protège
  /// des doubles envois de formulaire sans bloquer un exposant qui vient aussi
  /// comme participant.
  @@unique([editionId, type, email])
  @@unique([editionId, type, sequence])
  @@index([editionId, status])
  @@index([createdAt])
}

model Exhibitor {
  id             String      @id @default(uuid())
  editionId      String
  registrationId String?     @unique
  companyName    String
  activitySector String
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  logoUrl        String?
  standNumber    String?
  standStatus    StandStatus @default(RESERVE)
  /// Montants en XOF, stockés en Decimal pour éviter les arrondis flottants
  /// sur des sommes qui finissent dans un rapport comptable.
  standFee       Decimal     @default(0) @db.Decimal(14, 2)
  paidAmount     Decimal     @default(0) @db.Decimal(14, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  edition      Edition       @relation(fields: [editionId], references: [id], onDelete: Cascade)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@unique([editionId, standNumber])
  @@index([editionId, standStatus])
}

model Sponsor {
  id         String       @id @default(uuid())
  editionId  String
  name       String
  level      SponsorLevel
  logoUrl    String?
  websiteUrl String?
  benefits   String[]     @default([])
  amount     Decimal      @default(0) @db.Decimal(14, 2)
  order      Int          @default(0)
  createdAt  DateTime     @default(now())

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId, level, order])
}

// ───────────────────────────── Budget & contact ─────────────────────────────

model BudgetEntry {
  id        String          @id @default(uuid())
  editionId String
  type      BudgetEntryType
  category  String
  label     String
  amount    Decimal         @db.Decimal(14, 2)
  currency  String          @default("XOF") @db.VarChar(3)
  date      DateTime        @db.Date
  createdById String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([editionId, type, date])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  handled   Boolean  @default(false)
  handledAt DateTime?
  createdAt DateTime @default(now())

  @@index([handled, createdAt])
}

/// Journal d'audit — qui a validé quelle inscription, qui a touché au budget.
/// Indispensable dès qu'on distribue 13 rôles sur un même back-office.
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}
