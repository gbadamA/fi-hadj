# ⚠️ NE PAS remettre en liens physiques (le défaut de pnpm).
#
# Par défaut pnpm crée des LIENS PHYSIQUES depuis son magasin global. Les liens
# physiques partagent l'inode — donc les attributs de fichier. Or d'autres projets
# du poste vivent sous OneDrive : OneDrive marque leurs fichiers d'un `ReparsePoint`,
# et cette marque contamine TOUTES les copies liées, y compris hors OneDrive.
# Windows répond alors `EINVAL: invalid argument` sur les readlink() des outils de
# build. `copy` casse le partage d'inode : chaque projet a ses propres fichiers.
package-import-method=copy

auto-install-peers=true
strict-peer-dependencies=false
